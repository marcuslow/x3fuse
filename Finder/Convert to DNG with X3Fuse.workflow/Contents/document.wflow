				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Convert to DNG with X3Fuse — Finder Quick Action
# Hands the selected X3F files (folders are searched recursively) to the installed
# X3Fuse app through its x3fuse://convert URL scheme. X3Fuse adds them to its queue
# and starts converting with the app's current settings (per-file format: DNG).

APP="/Applications/X3Fuse.app"
BUNDLE_ID="com.sagwa.X3Fuse"
BATCH=25

files=()
for item in "$@"; do
    if [ -d "$item" ]; then
        while IFS= read -r -d '' f; do
            files+=("$f")
        done &lt; &lt;(find "$item" -type f -iname '*.x3f' -print0 | sort -z)
    else
        case "$item" in
            *.[Xx]3[Ff]) files+=("$item") ;;
        esac
    fi
done

if [ "${#files[@]}" -eq 0 ]; then
    osascript -e 'display notification "No X3F files in the selection." with title "X3Fuse"'
    exit 0
fi

# Percent-encode the paths (JavaScript for Automation is always present; handles Unicode).
encode() {
    osascript -l JavaScript -e 'function run(a){return a.map(p =&gt; "path=" + encodeURIComponent(p)).join("&amp;")}' "$@"
}

open_with_x3fuse() {
    if [ -d "$APP" ]; then
        open -a "$APP" "$1"
    else
        open -b "$BUNDLE_ID" "$1"
    fi
}

i=0
while [ "$i" -lt "${#files[@]}" ]; do
    chunk=("${files[@]:$i:$BATCH}")
    query="$(encode "${chunk[@]}")"
    open_with_x3fuse "x3fuse://convert?format=dng&amp;${query}" || {
        osascript -e 'display notification "X3Fuse could not be opened. Is it installed in /Applications?" with title "X3Fuse"'
        exit 1
    }
    i=$((i + BATCH))
done</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/bash</string>
